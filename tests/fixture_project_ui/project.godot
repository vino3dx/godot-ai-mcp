; Hand-written minimal project used by the runtime_inspect_ui real-engine test.
; Tests copy this directory to a temp dir (mkdtemp) before running Godot, so the repo copy stays pristine.
; Not an engine-generated fixture: those live in tests/fixtures.
; viewport 640x360 is intentional - the probe asserts layout numbers derived from it.

config_version=5

[application]

config/name="UiInspectFixture"
run/main_scene="res://main.tscn"

[display]

window/size/viewport_width=640
window/size/viewport_height=360

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
